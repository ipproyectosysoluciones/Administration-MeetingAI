---
import { RegisterForm } from "../components/auth/RegisterForm";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>ReunionAI — Crear cuenta</title>
  </head>
  <body>
    <main>
      <h1>Crear cuenta</h1>
      <RegisterForm
        client:load
        onSuccess={() => {
          window.location.href = "/dashboard";
        }}
      />
      <p>¿Ya tenés cuenta? <a href="/login">Ingresá</a></p>
    </main>
  </body>
</html>

---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - ReunionAI</title>
  </head>
  <body class="min-h-screen bg-gray-50 dark:bg-gray-950 flex">
    <slot />
  </body>
</html>